\set VERBOSITY terse
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS jsonvd;
-- parse_value: each text yields the JSON value it represents
SELECT v AS input, jsonvd.parse_value(v) AS value, jsonvd.typeof_text(v) AS type
FROM unnest(ARRAY[
	'null', 'true', 'false', '0', '1', '-12', '1.5', '2e3', '-0.5E-2',
	'{"a":1}', '[1,"x"]', '"quoted"', 'hello', 'O''Brien', '007', '1.', '{broken',
	'2018-05-11', 'TRUE', '  42  ', ''
]) AS v;
   input    |    value     |  type   
------------+--------------+---------
 null       | null         | null
 true       | true         | boolean
 false      | false        | boolean
 0          | 0            | number
 1          | 1            | number
 -12        | -12          | number
 1.5        | 1.5          | number
 2e3        | 2000         | number
 -0.5E-2    | -0.005       | number
 {"a":1}    | {"a": 1}     | object
 [1,"x"]    | [1, "x"]     | array
 "quoted"   | "quoted"     | string
 hello      | "hello"      | string
 O'Brien    | "O'Brien"    | string
 007        | "007"        | string
 1.         | "1."         | string
 {broken    | "{broken"    | string
 2018-05-11 | "2018-05-11" | string
 TRUE       | "TRUE"       | string
   42       | 42           | number
            | ""           | string
(21 rows)

-- SQL NULL in, SQL NULL out
SELECT jsonvd.parse_value(NULL) IS NULL AS strict_null;
 strict_null 
-------------
 t
(1 row)

