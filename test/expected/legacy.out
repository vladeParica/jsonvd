\set VERBOSITY terse
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS jsonvd;
CREATE TEMP TABLE songs AS SELECT
'[{"song":"Somebody told me","banda":"The killers"},
  {"song":"Miss Atomic Bomb","banda":"The killers"},
  {"song":"Fix you","banda":"Coldplay",
   "nodo_maluma":[{"song":"Tu me partiste el corazon","banda":"maluma"},{"song":"mientes","banda":"camila"}],
   "solista":{"song":"Let me","cantante":"zayn"}}]'::jsonb AS d;
-- The key of the last step is not entered (same as the original procedures)
SELECT steps, jsonvd.legacy_path(d, steps::jsonb) AS path, d #> jsonvd.legacy_path(d, steps::jsonb) AS value
FROM songs, (VALUES
	('[{"clave":"nodo_maluma","posicion":2},{"posicion":1}]'),
	('[{"clave":"nodo_maluma","posicion":2}]'),
	('[{"clave":"solista","posicion":2},{}]'),
	('[{"posicion":0}]'),
	('[]')
) AS s(steps);
                         steps                         |       path        |                                                                                                                                                            value                                                                                                                                                             
-------------------------------------------------------+-------------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 [{"clave":"nodo_maluma","posicion":2},{"posicion":1}] | {2,nodo_maluma,1} | {"song": "mientes", "banda": "camila"}
 [{"clave":"nodo_maluma","posicion":2}]                | {2}               | {"song": "Fix you", "banda": "Coldplay", "solista": {"song": "Let me", "cantante": "zayn"}, "nodo_maluma": [{"song": "Tu me partiste el corazon", "banda": "maluma"}, {"song": "mientes", "banda": "camila"}]}
 [{"clave":"solista","posicion":2},{}]                 | {2,solista}       | {"song": "Let me", "cantante": "zayn"}
 [{"posicion":0}]                                      | {0}               | {"song": "Somebody told me", "banda": "The killers"}
 []                                                    | {}                | [{"song": "Somebody told me", "banda": "The killers"}, {"song": "Miss Atomic Bomb", "banda": "The killers"}, {"song": "Fix you", "banda": "Coldplay", "solista": {"song": "Let me", "cantante": "zayn"}, "nodo_maluma": [{"song": "Tu me partiste el corazon", "banda": "maluma"}, {"song": "mientes", "banda": "camila"}]}]
(5 rows)

-- object root: "posicion" is ignored while the node is not an array
SELECT jsonvd.legacy_path(
	'{"id":367,"categorias":[{"idCategoria":2,"otro_nodo":{"tu_tia":"ana maria"}}]}',
	'[{"clave":"categorias","posicion":1},{"clave":"otro_nodo","posicion":0}]');
  legacy_path   
----------------
 {categorias,0}
(1 row)

-- round trip: to_legacy_path -> legacy_path returns the same path
SELECT p.path, jsonvd.to_legacy_path(d, p.path) AS steps,
       jsonvd.legacy_path(d, jsonvd.to_legacy_path(d, p.path)) = p.path AS roundtrip
FROM songs, LATERAL jsonvd.flatten(d) AS p
WHERE p.depth BETWEEN 1 AND 4 AND p.type IN ('object', 'array', 'string')
ORDER BY p.path
LIMIT 12;
          path           |                                      steps                                       | roundtrip 
-------------------------+----------------------------------------------------------------------------------+-----------
 {0}                     | [{"posicion": 0}]                                                                | t
 {0,banda}               | [{"clave": "banda", "posicion": 0}, {}]                                          | t
 {0,song}                | [{"clave": "song", "posicion": 0}, {}]                                           | t
 {1}                     | [{"posicion": 1}]                                                                | t
 {1,banda}               | [{"clave": "banda", "posicion": 1}, {}]                                          | t
 {1,song}                | [{"clave": "song", "posicion": 1}, {}]                                           | t
 {2}                     | [{"posicion": 2}]                                                                | t
 {2,banda}               | [{"clave": "banda", "posicion": 2}, {}]                                          | t
 {2,nodo_maluma}         | [{"clave": "nodo_maluma", "posicion": 2}, {}]                                    | t
 {2,nodo_maluma,0}       | [{"clave": "nodo_maluma", "posicion": 2}, {"posicion": 0}]                       | t
 {2,nodo_maluma,0,banda} | [{"clave": "nodo_maluma", "posicion": 2}, {"clave": "banda", "posicion": 0}, {}] | t
 {2,nodo_maluma,0,song}  | [{"clave": "nodo_maluma", "posicion": 2}, {"clave": "song", "posicion": 0}, {}]  | t
(12 rows)

SELECT bool_and(jsonvd.legacy_path(d, jsonvd.to_legacy_path(d, p.path)) = p.path) AS all_roundtrip
FROM songs, LATERAL jsonvd.flatten(d) AS p;
 all_roundtrip 
---------------
 t
(1 row)

-- errors
SELECT jsonvd.legacy_path('[1]', '{"clave":"x"}');
ERROR:  jsonvd.legacy_path: expected an array of {"clave", "posicion"} steps, got object
SELECT jsonvd.to_legacy_path('{"a":1}', '{a,b}');
ERROR:  jsonvd.to_legacy_path: path {a,b} does not exist in the document
